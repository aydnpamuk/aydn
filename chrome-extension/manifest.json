{
  "manifest_version": 3,
  "name": "AYDN - Amazon Review Analyzer",
  "description": "Etik Amazon yorum toplayıcı ve analiz aracı. Amazon sayfalarından yorumları toplar ve backend'e gönderir.",
  "version": "1.0.0",
  "author": "AYDN Team",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.de/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.it/*",
    "*://*.amazon.es/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.co.jp/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/product-reviews/*",
        "*://*.amazon.de/product-reviews/*",
        "*://*.amazon.co.uk/product-reviews/*",
        "*://*.amazon.fr/product-reviews/*",
        "*://*.amazon.it/product-reviews/*",
        "*://*.amazon.es/product-reviews/*",
        "*://*.amazon.ca/product-reviews/*",
        "*://*.amazon.co.jp/product-reviews/*"
      ],
      "js": [
        "content/parser.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*"
      ],
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.de/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.es/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.co.jp/*"
      ]
    }
  ]
}
