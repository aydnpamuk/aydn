{
  "manifest_version": 3,
  "name": "AYDN - Amazon Review Analyzer (Standalone)",
  "description": "Collect Amazon reviews locally - NO BACKEND REQUIRED. All data stored in your browser.",
  "version": "2.0.0",
  "author": "AYDN Team",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.amazon.com/*",
    "*://*.amazon.de/*",
    "*://*.amazon.co.uk/*",
    "*://*.amazon.fr/*",
    "*://*.amazon.it/*",
    "*://*.amazon.es/*",
    "*://*.amazon.ca/*",
    "*://*.amazon.co.jp/*"
  ],
  "action": {
    "default_popup": "popup/popup-standalone.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    },
    "default_title": "AYDN - View Dashboard"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker-standalone.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/product-reviews/*",
        "*://*.amazon.de/product-reviews/*",
        "*://*.amazon.co.uk/product-reviews/*",
        "*://*.amazon.fr/product-reviews/*",
        "*://*.amazon.it/product-reviews/*",
        "*://*.amazon.es/product-reviews/*",
        "*://*.amazon.ca/product-reviews/*",
        "*://*.amazon.co.jp/product-reviews/*"
      ],
      "js": [
        "lib/storage.js",
        "lib/sentiment.js",
        "content/parser.js",
        "content/content-standalone.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "dashboard/dashboard.html"
      ],
      "matches": [
        "*://*.amazon.com/*",
        "*://*.amazon.de/*",
        "*://*.amazon.co.uk/*",
        "*://*.amazon.fr/*",
        "*://*.amazon.it/*",
        "*://*.amazon.es/*",
        "*://*.amazon.ca/*",
        "*://*.amazon.co.jp/*"
      ]
    }
  ]
}
